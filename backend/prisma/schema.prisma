// file: backend/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider                  = "prisma-client-py"
  interface                 = "asyncio"
  recursive_type_depth      = -1
  enable_experimental_decimal = true
}

model User {
  discord_id        String              @id @db.VarChar(64)
  username          String              @db.VarChar(100)
  experience_points BigInt              @default(0)
  player_class      String              @default("Adventurer") @db.VarChar(30)
  gold_balance      Decimal             @default(100.00) @db.Decimal(15, 2)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  last_active_at    DateTime            @default(now()) @db.Timestamptz(6)
  custom_title      String?             @db.VarChar(100)
  language          String              @default("en") @db.VarChar(10)
  color_role_id     String?             @db.VarChar(64)
  equipped_background String            @default("default") @db.VarChar(64)
  inventories       UserInventory[]
  transactions      MarketTransaction[]
  warnings          UserWarning[]
  tickets           Ticket[]
  daily_reward      DailyReward?
  credit_transactions CreditTransaction[]
  backgrounds       UserBackground[]

  @@map("users")
}

model Item {
  item_id          Int                 @id @default(autoincrement())
  name             String              @unique @db.VarChar(100)
  description      String?             @db.Text
  rarity           String              @db.VarChar(20) // 'Common', 'Uncommon', 'Rare', 'Epic', 'Legendary'
  base_value       Decimal             @db.Decimal(12, 2)
  is_consumable    Boolean             @default(false)
  inventories      UserInventory[]
  commodities      MarketCommodity[]
  transactions     MarketTransaction[]

  @@map("items")
}

model UserInventory {
  discord_id String  @db.VarChar(64)
  item_id    Int
  quantity   Int     @default(0)
  user       User    @relation(fields: [discord_id], references: [discord_id], onDelete: Cascade)
  item       Item    @relation(fields: [item_id], references: [item_id], onDelete: Cascade)

  @@id([discord_id, item_id])
  @@index([discord_id])
  @@map("user_inventories")
}

model MarketCommodity {
  commodity_id      Int      @id @default(autoincrement())
  item_id           Int      @unique
  current_price     Decimal  @db.Decimal(12, 2)
  supply_pool       Int      @default(1000)
  demand_multiplier Decimal  @default(1.00) @db.Decimal(4, 2)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  item              Item     @relation(fields: [item_id], references: [item_id], onDelete: Cascade)

  @@map("market_commodities")
}

model LoreLedger {
  event_id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type          String   @db.VarChar(50)
  raw_trigger_summary String   @db.Text
  generated_lore      String   @db.Text
  recorded_at         DateTime @default(now()) @db.Timestamptz(6)

  @@map("lore_ledger")
}

model MarketTransaction {
  transaction_id   Int      @id @default(autoincrement())
  discord_id       String   @db.VarChar(64)
  item_id          Int
  transaction_type String   @db.VarChar(10) // 'BUY' or 'SELL'
  quantity         Int
  unit_price       Decimal  @db.Decimal(12, 2)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  user             User     @relation(fields: [discord_id], references: [discord_id], onDelete: Cascade)
  item             Item     @relation(fields: [item_id], references: [item_id], onDelete: Cascade)

  @@map("market_transactions")
}

model UserWarning {
  warning_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discord_id   String   @db.VarChar(64)
  moderator_id String   @db.VarChar(64)
  reason       String   @db.Text
  issued_at    DateTime @default(now()) @db.Timestamptz(6)
  user         User     @relation(fields: [discord_id], references: [discord_id], onDelete: Cascade)

  @@map("user_warnings")
}

model Ticket {
  ticket_id  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discord_id String    @db.VarChar(64)
  channel_id String    @unique @db.VarChar(64)
  status     String    @db.VarChar(20) // 'OPEN', 'CLOSED'
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  closed_at  DateTime? @db.Timestamptz(6)
  user       User      @relation(fields: [discord_id], references: [discord_id], onDelete: Cascade)

  @@map("tickets")
}

model DailyReward {
  discord_id      String   @id @db.VarChar(64)
  last_claimed_at DateTime @db.Timestamptz(6)
  current_streak  Int      @default(0)
  user            User     @relation(fields: [discord_id], references: [discord_id], onDelete: Cascade)

  @@map("daily_rewards")
}

model ReputationLog {
  log_id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_id   String   @db.VarChar(64)
  receiver_id String   @db.VarChar(64)
  given_at    DateTime @default(now()) @db.Timestamptz(6)

  @@map("reputation_logs")
}

model TempChannelSetting {
  guild_id         String   @id @db.VarChar(64)
  hub_channel_id   String?  @db.VarChar(64)
  enabled          Boolean  @default(true)
  max_channels     Int      @default(3)
  cooldown_seconds Int      @default(10)

  @@map("temp_channel_settings")
}

model CreditTransaction {
  transaction_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discord_id     String   @db.VarChar(64)
  amount         Decimal  @db.Decimal(15, 2)
  description    String   @db.VarChar(256)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  user           User     @relation(fields: [discord_id], references: [discord_id], onDelete: Cascade)

  @@map("credit_transactions")
}

model UserBackground {
  discord_id   String   @db.VarChar(64)
  background_id String   @db.VarChar(64)
  purchased_at DateTime @default(now()) @db.Timestamptz(6)
  user         User     @relation(fields: [discord_id], references: [discord_id], onDelete: Cascade)

  @@id([discord_id, background_id])
  @@map("user_backgrounds")
}

model WelcomeSetting {
  guild_id       String   @id @db.VarChar(64)
  enabled        Boolean  @default(false)
  channel_id     String?  @db.VarChar(64)
  welcome_text   String   @default("Welcome [user] to [server]!") @db.Text
  avatar_shape   String   @default("circle") @db.VarChar(20)
  avatar_size    Int      @default(128)
  avatar_x       Int      @default(50)
  avatar_y       Int      @default(50)
  username_x     Int      @default(50)
  username_y     Int      @default(200)
  background_url String?  @db.VarChar(512)

  @@map("welcome_settings")
}

model AutoResponse {
  response_id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guild_id          String   @db.VarChar(64)
  trigger_keyword   String   @db.VarChar(128)
  matching_rule     String   @default("exact") @db.VarChar(20)
  reply_content     String   @db.Text
  is_embed          Boolean  @default(false)
  embed_template_id String?  @db.VarChar(64)
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@map("auto_responses")
}

